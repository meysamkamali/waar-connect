# waar Connect phase 0 — copy to .env and fill in. Never commit .env.

# Where the Node server listens (Nginx on aaPanel proxies to it).
PORT=8787

# LiveKit media server. The URL is what the browsers connect to (wss://...).
LIVEKIT_URL=wss://media.connect.waar.work
LIVEKIT_API_KEY=changeme-key
LIVEKIT_API_SECRET=changeme-secret-at-least-32-characters-long

# Shared PIN that the phase 0 pages ask for before they can mint a token.
# Leave empty for no PIN during tests. Phase 1 replaces this with real logins and invite links.
PHASE0_PIN=

# Public link to this repository, shown in the page footer (AGPL section 13).
SOURCE_URL=https://github.com/meysamkamali/waar-connect
