# waar Connect API — copy to .env and fill in. Never commit .env.

PORT=8788

# Postgres (deploy/vm/db runs it in Docker on the VM, local only)
DATABASE_URL=postgres://waarconnect:changeme@127.0.0.1:5432/waarconnect

# LiveKit: same key and secret as the media server (deploy/media credentials.env)
LIVEKIT_URL=wss://media.connect.waar.work:8443
LIVEKIT_API_KEY=waarconnect
LIVEKIT_API_SECRET=changeme-secret-at-least-32-characters-long

# Where the pages live; invite links are built from this.
PUBLIC_URL=https://connect.waar.work:8443

# Sessions for producers and engineers
SESSION_TTL_HOURS=12
# 1 in production (HTTPS). 0 only for http://localhost development.
COOKIE_SECURE=1

# Studio output slots a new program gets by default
DEFAULT_SLOTS=4

# Test phase: 1 = producer and engineer screens open without a password (the screen picks the role).
# Set 0 for the final phase; then only users from `npm run user:add` can sign in.
OPEN_ACCESS=1
