# waar Connect gateway — copy to .env and fill in. Never commit .env.

# The API; on the VM it listens on localhost only. From another machine: https://connect.waar.work:8443
API_URL=http://127.0.0.1:8788

# Same value as GATEWAY_TOKEN in apps/api/.env (install-gateway.sh writes both).
GATEWAY_TOKEN=changeme-at-least-16-characters

# Shown to the admin as where the gateway runs (default: the machine's hostname).
# GATEWAY_NAME=connect
# Each return feed runs in a process of its own (process, the default). inline keeps them all in the
# gateway's process: one JavaScript thread for all of them, enough for one 1080p25 feed only.
# GATEWAY_FEEDS=process

# NDI runtime, found automatically in the usual places; set when it lives elsewhere.
# NDI_LIB=/usr/local/lib/libndi.so.6
# libyuv fits pictures for the NDI outputs (package libyuv0); found automatically, done without when absent.
# YUV_LIB=/usr/lib/x86_64-linux-gnu/libyuv.so.0

# NDI senders on other subnets (mDNS does not cross routers), comma-separated IPs. The admin page keeps
# its own list (Admin → NDI senders on other networks); this one is added to it.
# NDI_EXTRA_IPS=10.1.1.101

# The program picture to the guests when a studio sets nothing of its own in the admin page: picture
# height (the program is scaled down before the encode; 540p costs about a quarter of 1080p; 0 = source
# size), bitrate cap, and frame-rate cap (a 50 fps program is sent at 25).
RETURN_HEIGHT=540
RETURN_MAX_KBPS=1500
RETURN_MAX_FPS=30

# Which NDI audio channels carry the mix-minus (1-based); averaged into one channel for the guests.
RETURN_AUDIO_CHANNELS=1,2

# LOG_LEVEL=info
